  "quickSizesLabel": "Common sizes",
  "@quickSizesLabel": {
    "description": "Phase 6: label above the quick-choice tile-size chips (e.g. 60x60) shown under the tile length/width fields on both calculator screens. Tapping a chip only fills the existing fields -- it is not a saved tile catalog."
  },

  "quickWastePercentLabel": "Quick allowance",
  "@quickWastePercentLabel": {
    "description": "Phase 6: label above the quick-choice waste-percentage chips (0%/5%/10%) shown under calculator 1's waste field. Tapping a chip only fills the existing field."
