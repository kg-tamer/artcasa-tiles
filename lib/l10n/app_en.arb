  "@clipboardWastePercentLabel": {
    "description": "Label for the waste-percentage line in the copied result text. Distinct from calc1FieldWastePercentLabel, which has an '(optional)' suffix that only makes sense on the input form, not when reporting a value that was actually entered."
  },

  "resultCartonsPerPalletLabel": "Cartons per pallet",
  "@resultCartonsPerPalletLabel": {
    "description": "Label for the cartons-per-pallet line, used both as a calculator 2 on-screen result row (since Phase 4) and in the copied result text. Distinct from fieldCartonsPerPalletLabel (the form field, which has an '(optional)' suffix only appropriate on the input form) for the same reason as clipboardWastePercentLabel. Renamed from clipboardCartonsPerPalletLabel in Phase 4 once it stopped being clipboard-only."
  },

  "clipboardPalletsCountLabel": "Pallets count",
  "@clipboardPalletsCountLabel": {
    "description": "Label for the pallets-count line in calculator 2's copied result text. Distinct from calc2FieldPalletsCountLabel for the same '(optional)' reason as clipboardWastePercentLabel."
